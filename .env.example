# Copie este arquivo para ".env" e preencha com sua chave da OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-coloque-sua-chave-aqui

# Opcional: troque o modelo gratuito usado. Os modelos :free da OpenRouter
# mudam de tempos em tempos (alguns saem do catálogo gratuito, outros
# aparecem) — se o padrão abaixo parar de funcionar, confira a lista atual
# em https://openrouter.ai/models?q=:free e troque aqui. Prefira modelos
# menores/mais leves: os muito grandes (ex: 500B+ parâmetros) tendem a ter
# fila bem mais longa no tier gratuito.
OPENROUTER_MODEL=poolside/laguna-s-2.1:free

# Opcional: caminho do banco, se não estiver na raiz do projeto.
DB_PATH=cinerocket.db
